# Copy this file to ".env" and edit values.
DATABASE_URL=sqlite:///./speakfree_c1.db
# PostgreSQL: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/speakfree  (pip install "psycopg[binary]")
# Apply Alembic migrations automatically when the API starts
AUTO_MIGRATE=true
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Login verification: lock an account for LOCKOUT_MINUTES after MAX_FAILED_LOGINS wrong passwords
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Whisper: tiny.en (fastest) | base.en (default) | small.en (more accurate, slower)
WHISPER_MODEL=base.en
WHISPER_DEVICE=auto

DYSFLUENCY_THRESHOLD=0.60
ENABLE_NOISE_REDUCTION=true
# Voice activity detection: silero (neural, noise-robust; pip install silero-vad) | energy
VAD_BACKEND=silero
ENABLE_HUBERT=false
MAX_UPLOAD_MB=25

# Hallucination guard: drop Whisper segments that are non-speech or impossible repetition loops
NO_SPEECH_THRESHOLD=0.75
MAX_WORDS_PER_SEC=8.0

# Task images are served from STATIC_DIR/tasks at /static/tasks (default: backend/static)
# STATIC_DIR=./static
MAX_IMAGE_MB=5

# ---- Integrated platform (Components 2-4) ----
# TORGO acoustic windows for Component 3 (computed while the audio is in memory; numbers only)
ENABLE_ACOUSTIC_BIOMARKERS=true
# Run C2 -> C3 -> C4 automatically when a screening session is finalised
RUN_PIPELINE_ON_FINALIZE=true
# Optional: AI assistant language-model fallback (Component 4)
# ANTHROPIC_API_KEY=
